/* =========================
   FAVORITE MOVIES
========================= */

let favorites =
    JSON.parse(
        localStorage.getItem("favorites")
    ) || [];


console.log("영화 개수:", movies.length);


/* =========================
   ELEMENT
========================= */

const search =
    document.querySelector("#search");

const searchBtn =
    document.querySelector("#searchBtn");

const filters =
    document.querySelectorAll(".filter");

const sort =
    document.querySelector("#sort");


/* =========================
   STATE
========================= */

let currentFilter = "전체";

let currentSort = "default";


/* =========================
   CREATE MOVIE CARDS
========================= */

function showMovies(list) {

    movieList.innerHTML = "";


    list.forEach(function(movie) {

        const isFavorite =
            favorites.includes(movie.title);

        const card =
            document.createElement("div");


        card.classList.add("movie-card");


        card.innerHTML = `

            <button
                class="like-btn ${isFavorite ? "liked" : ""}"
                type="button"
                aria-label="찜하기"
            >
                ${isFavorite ? "♥" : "♡"}
            </button>

            <div class="img-box">

                <img
                    src="${movie.image}"
                    alt="${movie.title}"
                    draggable="false"
                >

            </div>

            <h3>
                ${movie.title}
            </h3>

            <p>
                ${movie.keyword}
            </p>

            <span class="rating">
                ★ ${movie.rating}
            </span>

        `;


        /* =========================
           SAVE PAGE
        ========================= */

        card.dataset.page =
            movie.page;


        movieList.appendChild(card);

    });

}


/* =========================
   SEARCH + FILTER + SORT
========================= */

function updateMovies() {

    const word =
        search.value
            .toLowerCase()
            .trim();


    let result =
        movies.filter(function(movie) {


            const matchSearch =
                movie.title
                    .toLowerCase()
                    .includes(word);


            const matchFilter =
                currentFilter === "전체" ||
                movie.keyword.includes(
                    currentFilter
                );


            return (
                matchSearch &&
                matchFilter
            );

        });


    /* =========================
       SORT
    ========================= */

    if (currentSort === "high") {

        result.sort(function(a, b) {

            return b.rating - a.rating;

        });

    }


    if (currentSort === "low") {

        result.sort(function(a, b) {

            return a.rating - b.rating;

        });

    }


    showMovies(result);

}


/* =========================
   INITIAL
========================= */

showMovies(movies);


/* =========================
   SEARCH BUTTON
========================= */

if (searchBtn) {

    searchBtn.addEventListener(
        "click",
        updateMovies
    );

}


/* =========================
   ENTER SEARCH
========================= */

if (search) {

    search.addEventListener(
        "keydown",
        function(e) {

            if (e.key === "Enter") {

                updateMovies();

            }

        }
    );

}


/* =========================
   FILTER
========================= */

filters.forEach(function(button) {

    button.addEventListener(
        "click",
        function() {


            filters.forEach(
                function(btn) {

                    btn.classList.remove(
                        "active"
                    );

                }
            );


            button.classList.add(
                "active"
            );


            currentFilter =
                button.dataset.filter;


            updateMovies();

        }
    );

});


/* =========================
   SORT
========================= */

if (sort) {

    sort.addEventListener(
        "change",
        function() {

            currentSort =
                sort.value;


            updateMovies();

        }
    );

}


/* =========================
   DRAG SCROLL
========================= */

let isDown = false;

let startX = 0;

let startScroll = 0;

let isDragging = false;


/* =========================
   POINTER DOWN
========================= */

movieList.addEventListener(
    "pointerdown",
    function(e) {

        isDown = true;

        isDragging = false;

        startX = e.clientX;

        startScroll =
            movieList.scrollLeft;

    }
);


/* =========================
   POINTER MOVE
========================= */

movieList.addEventListener(
    "pointermove",
    function(e) {

        if (!isDown) return;


        const move =
            e.clientX - startX;


        /* 드래그 시작 기준 */

        if (Math.abs(move) > 8) {

            isDragging = true;

        }


        if (isDragging) {

            movieList.scrollLeft =
                startScroll - move;

        }

    }
);


/* =========================
   POINTER UP
========================= */

movieList.addEventListener(
    "pointerup",
    function() {

        isDown = false;

    }
);


/* =========================
   POINTER LEAVE
========================= */

movieList.addEventListener(
    "pointerleave",
    function() {

        isDown = false;

    }
);


/* =========================
   POINTER CANCEL
========================= */

movieList.addEventListener(
    "pointercancel",
    function() {

        isDown = false;

        isDragging = false;

    }
);


/* =========================
   CARD + LIKE CLICK
========================= */

movieList.addEventListener(
    "click",
    function(e) {

        /* =========================
           LIKE BUTTON
        ========================= */

        const likeBtn =
            e.target.closest(".like-btn");


       if (likeBtn) {

            const card =
                likeBtn.closest(".movie-card");


            const movieTitle =
                card.querySelector("h3").textContent.trim();


            const favoriteIndex =
                favorites.indexOf(movieTitle);


            if (favoriteIndex === -1) {

                favorites.push(movieTitle);

                likeBtn.classList.add("liked");

                likeBtn.textContent = "♥";

            } else {

                favorites.splice(favoriteIndex, 1);

                likeBtn.classList.remove("liked");

                likeBtn.textContent = "♡";

            }


            localStorage.setItem(
                "favorites",
                JSON.stringify(favorites)
            );


            return;

        }


        /* =========================
           MOVIE CARD
        ========================= */

        const card =
            e.target.closest(".movie-card");


        if (!card) return;


        /* 드래그였다면 이동하지 않음 */

        if (isDragging) {

            isDragging = false;

            return;

        }


        /* DETAIL PAGE */

        const page =
            card.dataset.page;


        if (page) {

            location.href = page;

        }

    }
);
